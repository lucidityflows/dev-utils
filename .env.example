# Copy to .env and export before running provision/02_install_woodpecker_ci.sh

# Base Server Provisioning (provision/01_provision_server.sh)
DEV_GROUP="devteam"
PROJECT_DIR="/srv/www/app"
DISABLE_IPV6="true"

# Woodpecker CI & Let's Encrypt TLS (provision/02_install_woodpecker_ci.sh)
CI_HOSTNAME="ci.example.com"
LETSENCRYPT_EMAIL="admin@example.com"
WOODPECKER_ADMIN_USER="lucidityflows"

# GitHub OAuth & Webhook HMAC Secrets (Required at runtime)
WOODPECKER_GITHUB_CLIENT_ID="your_github_oauth_client_id"
WOODPECKER_GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_WEBHOOK_SECRET="generate_with_openssl_rand_hex_32"

# Operational Report Retention (scripts/reports-cleanup.sh)
REPORTS_DIR="/var/log/server-reports"
