# File: /etc/nginx/sites-available/woodpecker
# Hardened reverse proxy config for Woodpecker CI
# Enforces HTTPS, GitHub webhook IP whitelist, rate limiting, and POST only on /github-webhook/

server {
    listen 80;
    server_name ci.local;  # Change to your domain

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ci.local;  # Change to your domain

    ssl_certificate /etc/letsencrypt/live/ci.local/fullchain.pem;  # Use certbot generated certs
    ssl_certificate_key /etc/letsencrypt/live/ci.local/privkey.pem;

    # Strong TLS settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Referrer-Policy no-referrer;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self';";

    # Rate limiting for webhook endpoint to prevent abuse
    limit_req_zone $binary_remote_addr zone=github_webhook_limit:10m rate=10r/m;

    # Location for webhook with IP whitelist and POST only
    location /github-webhook/ {
        limit_req zone=github_webhook_limit burst=5 nodelay;


        # Allow GitHub IPs only (update regularly from https://api.github.com/meta)
        set_real_ip_from 140.82.112.0/20;
        set_real_ip_from 185.199.108.0/22;
        set_real_ip_from 192.30.252.0/22;
        set_real_ip_from 2606:50c0::/32;
        real_ip_header X-Forwarded-For;

        if ($request_method != POST) {
            return 405;
        }

        proxy_pass http://localhost:8000/github-webhook/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Verify webhook secret (optional - requires additional tooling)
    }

    # Default proxy for other Woodpecker traffic
    location / {
        proxy_pass http://localhost:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
