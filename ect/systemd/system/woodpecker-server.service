[Unit]
Description=Woodpecker CI Server
Documentation=https://woodpecker-ci.org
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/woodpecker-server
Restart=on-failure
RestartSec=5s
User=woodpecker
Group=woodpecker
EnvironmentFile=/etc/woodpecker/server.env
WorkingDirectory=/var/lib/woodpecker

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/woodpecker /var/lib/woodpecker /var/log/woodpecker
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Sandboxing
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=woodpecker-server

[Install]
WantedBy=multi-user.target
