[Unit]
Description=Woodpecker CI stack via Docker Compose
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/woodpecker
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
User=woodpecker
Group=root
UMask=0077

[Install]
WantedBy=multi-user.target
