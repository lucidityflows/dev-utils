# Woodpecker CI Agent Configuration

# Connection to server
WOODPECKER_SERVER=https://ci.lucidityflows.dev
WOODPECKER_SECRET=super_secure_agent_secret_here

# Agent identity
WOODPECKER_AGENT_NAME=agent-01
WOODPECKER_AGENT_MAX_PROCS=2
WOODPECKER_AGENT_FILTER_LABELS=default
WOODPECKER_AGENT_FILTER_PLATFORMS=linux/amd64

# Docker backend
WOODPECKER_BACKEND=docker
WOODPECKER_BACKEND_DOCKER_HOST=unix:///var/run/docker.sock
WOODPECKER_BACKEND_DOCKER_CAP_ADD=NET_ADMIN
WOODPECKER_BACKEND_DOCKER_NETWORK=bridge

# Logging
WOODPECKER_LOG_LEVEL=info
WOODPECKER_LOG_FILE=/var/log/woodpecker/agent.log
