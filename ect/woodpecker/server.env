# Woodpecker CI Server Configuration

# Core setup
WOODPECKER_HOST=https://ci.lucidityflows.dev
WOODPECKER_PORT=:8000
WOODPECKER_ADMIN=rob,zac
WOODPECKER_OPEN=true

# GitHub OAuth App (org-restricted)
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=xxxxxxxxxxxxxxxxxxxx
WOODPECKER_GITHUB_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Org restriction
WOODPECKER_GITHUB_ORGS=lucidityflows

# Shared secret with agents (rotate regularly)
WOODPECKER_SECRET=super_secure_agent_secret_here

# Database
WOODPECKER_DATABASE_DRIVER=sqlite3
WOODPECKER_DATABASE_DATASOURCE=/var/lib/woodpecker/woodpecker.db

# GPG signing
WOODPECKER_GPG_SIGNING_KEY=/etc/woodpecker/secrets/signingkey.asc
WOODPECKER_GPG_SIGNING_KEY_PASSWORD=use_gpg_agent_or_protected_file

# Logging
WOODPECKER_LOG_LEVEL=info
WOODPECKER_LOG_FILE=/var/log/woodpecker/server.log
