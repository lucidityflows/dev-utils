location = /github-webhook/ {
    # GitHub IP whitelist as before
    set_real_ip_from 192.30.252.0/22;
    set_real_ip_from 185.199.108.0/22;
    set_real_ip_from 140.82.112.0/20;
    set_real_ip_from 143.55.64.0/20;
    real_ip_header X-Forwarded-For;

    allow 192.30.252.0/22;
    allow 185.199.108.0/22;
    allow 140.82.112.0/20;
    allow 143.55.64.0/20;
    deny all;

    proxy_pass http://localhost:8000/github-webhook/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    # Reject non-POST requests early
    if ($request_method !~ ^POST$) {
      return 405;
    }
}
